datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String  @id @default(uuid())
  name     String?
  email    String  @unique
  password String
  role     String  @default("USER")

  articles Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       String    @id @default(uuid())
  slug     String    @unique
  name     String
  articles Article[]
}

model Article {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  summary      String
  body         String   @db.Text
  imageUrl     String?
  imageAlt     String?
  readMinutes  Int      @default(3)
  isBreaking   Boolean  @default(false)
  featuredRank Int?
  publishedAt  DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt(sort: Desc)])
  @@index([categoryId, publishedAt(sort: Desc)])
  @@index([isBreaking, publishedAt(sort: Desc)])
  @@index([featuredRank])
  @@index([authorId])
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

